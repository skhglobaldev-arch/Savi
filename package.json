{
  "name": "ai-workspace-mvp",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-apphosting-assets.mjs",
    "start": "next start",
    "dataconnect:compile:prod": "firebase --project prod --config firebase.production.json dataconnect:compile --service savi-production-607fd-service --location europe-west2",
    "production:preflight": "node scripts/production-preflight.mjs",
    "account-deletion:review": "node --experimental-strip-types scripts/process-account-deletion.ts",
    "test:pdf": "node --experimental-strip-types --test lib/pdf/hybridPdf.test.ts lib/pdf/workflowState.test.ts",
    "test:security": "node --experimental-strip-types --test lib/savi/backendSecurity.test.ts lib/savi/rateLimitPolicy.test.ts",
    "test:security:runtime": "node -r sucrase/register --test lib/savi/rateLimitRuntime.test.ts",
    "test:integrity": "node --experimental-strip-types --test lib/savi/creditIntegrity.test.ts lib/commerce/commerceIntegrity.test.ts"
  },
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "jszip": "^3.10.1",
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.24",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  }
}
